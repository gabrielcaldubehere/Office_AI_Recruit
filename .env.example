# ==========================================
# 1. BASE DE DATOS (SUPABASE)
# ==========================================
# Lo encuentras en Supabase -> Project Settings -> API
SUPABASE_URL="https://tu-proyecto-id.supabase.co"

# ⚠️ CRÍTICO: Usa la clave 'service_role' (secret), NO la 'anon' (public).
# Esta clave permite a Sara escribir logs y saltar RLS desde tu servidor privado.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# ==========================================
# 2. MODELOS DE IA GRATUITOS (PROVEEDORES LLM)
# ==========================================
# Al menos debes completar UNA clave para que el sistema funcione.
# Si completas las 3, tendrás el sistema de respaldo (fallback) activo.

# Groq (Principal rápido - console.groq.com)
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"

# Google AI Studio (Razonamiento / Auditoría - aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# OpenRouter (Respaldo gratuito - openrouter.ai)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"


# ==========================================
# 3. CONFIGURACIÓN DEL SERVIDOR Y HORARIOS
# ==========================================
# Zona horaria exacta para que Sara respete tus horarios de pausa/actividad
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# Orígenes permitidos para CORS. El backend acepta CORS_ORIGINS o ALLOWED_ORIGINS.
# En local podés dejarlo vacío: por defecto habilita localhost:5173 y 127.0.0.1:5173.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
CORS_ORIGINS=""

# Vite lee esta variable desde frontend/.env (no desde la raíz). Si falta, usa
# http://127.0.0.1:8000 como valor por defecto.
VITE_API_BASE_URL="http://127.0.0.1:8000"

# ==========================================
# 4. AUTENTICACIÓN DEL OPERADOR
# ==========================================
# Usuario que puede aprobar/rechazar, correr lotes y usar el escritorio de Luciano.
OFFICE_ADMIN_USER="Caldegrey"

# Generar con: backend/.venv/bin/python -c "from backend.auth import hash_password_pbkdf2; print(hash_password_pbkdf2('tu-clave'))"
# El hash anterior debe tener formato pbkdf2_sha256$iteraciones$salt$digest.
OFFICE_ADMIN_PASSWORD_HASH="pbkdf2_sha256$260000$...$..."

# Secreto para firmar tokens de sesión. Nunca dejes el fallback de desarrollo en producción.
OFFICE_AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# ==========================================
# 5. GMAIL CONTROLADO (SOLO LECTURA / ETIQUETAS / REGISTRO)
# ==========================================
# Cuenta autorizada: caldubeheregabriel@gmail.com
# Nunca subas credentials.json ni gmail_token.json al repositorio.
GMAIL_ENABLED="true"
GMAIL_CREDENTIALS_PATH="backend/credentials.json"
GMAIL_TOKEN_PATH="backend/gmail_token.json"
GMAIL_ALLOW_INTERACTIVE_AUTH="false"

# ==========================================
# 6. FUENTES DE EMPLEO / CLIENTES
# ==========================================
# Upwork discontinuó RSS en 2024: dejá vacío para usar lote estructurado,
# o definí una URL propia si tu cuenta genera un feed alternativo.
UPWORK_RSS_URL=""
FREELANCER_RSS_URL="https://www.freelancer.com/rss.xml"
MARKETPLACE_LIMIT="5"

# Filtro estricto: nada con más de 15 días de antigüedad pasa al LLM.
SOURCE_MAX_AGE_DAYS="15"

# Presupuesto diario: Sara frena antes de quemar todo el cupo (85% por defecto).
DAILY_TOKEN_LIMIT="150000"
TOKEN_ALERT_THRESHOLD="0.85"

# Arranque automático al iniciar sesión. Intervalos en minutos y corridas simultáneas.
AUTO_ENABLED="true"
AUTO_JOB_LIMIT="10"
AUTO_CLIENT_LIMIT="10"
AUTO_MIN_FIT_SCORE="60"
AUTO_MATEO_INTERVAL_MINUTES="30"
AUTO_VALERIA_INTERVAL_MINUTES="45"