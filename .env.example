# ==========================================
# 1. BASE DE DATOS (SUPABASE)
# ==========================================
# Lo encuentras en Supabase -> Project Settings -> API
SUPABASE_URL="https://tu-proyecto-id.supabase.co"

# ⚠️ CRÍTICO: Usa la clave 'service_role' (secret), NO la 'anon' (public).
# Esta clave permite a Sara escribir logs y saltar RLS desde tu servidor privado.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# ==========================================
# 2. MODELOS DE IA GRATUITOS (PROVEEDORES LLM)
# ==========================================
# Al menos debes completar UNA clave para que el sistema funcione.
# Si completas las 3, tendrás el sistema de respaldo (fallback) activo.

# Groq (Principal rápido - console.groq.com)
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"

# Google AI Studio (Razonamiento / Auditoría - aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# OpenRouter (Respaldo gratuito - openrouter.ai)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"


# ==========================================
# 3. CONFIGURACIÓN DEL SERVIDOR Y HORARIOS
# ==========================================
# Zona horaria exacta para que Sara respete tus horarios de pausa/actividad
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# Orígenes permitidos para CORS (en desarrollo local "*" sirve; luego pondrás la URL de Vercel)
ALLOWED_ORIGINS="*"